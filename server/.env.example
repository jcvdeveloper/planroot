# Planroot — variaveis de ambiente do backend.
# Copie para server/.env (ignorado pelo git) ou configure no painel do host.
# Nenhum valor real deve entrar neste arquivo.

# --------------------------------------------------------------------------- #
# Pagamento (Asaas)
# --------------------------------------------------------------------------- #

# mock  -> nao chama o Asaas; gera um Pix falso e libera o botao
#          "Simular pagamento". Use em desenvolvimento.
# live  -> chama o Asaas de verdade (sandbox ou producao, conforme a BASE_URL).
# Sem ASAAS_API_KEY o codigo cai em mock automaticamente.
ASAAS_MODE=mock

# Token de acesso do Asaas. Server-side apenas — nunca chega ao browser.
ASAAS_API_KEY=

# Sandbox: https://sandbox.asaas.com/api/v3  (padrao)
# Producao: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Token conferido no header access_token do webhook POST /api/webhook/asaas.
# Vazio = o webhook aceita qualquer chamada. Preencher antes de ir para producao.
ASAAS_WEBHOOK_TOKEN=

# CPF usado para criar o cliente pagador quando o front nao envia um.
# O padrao do codigo e o CPF de teste do sandbox do Asaas.
ASAAS_DEFAULT_CPF=

# --------------------------------------------------------------------------- #
# Aplicacao
# --------------------------------------------------------------------------- #

# Preco do blueprint em reais. Padrao: 20.00
PLANROOT_PRICE=20.00

# Caminho do SQLite de sessoes. Sem a variavel, usa server/planroot.db.
# Em host com disco efemero os dados somem a cada deploy; aponte para o
# volume persistente quando houver um (ex.: /data/planroot.db).
PLANROOT_DB_PATH=
